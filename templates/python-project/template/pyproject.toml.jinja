[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">={{ python_version }}"
dependencies = [
    "pydantic>=2",
    "pydantic-settings>=2",
]

[project.scripts]
{{ project_name }} = "{{ package_name }}.entrypoints.cli:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[dependency-groups]
dev = [
    "mypy>=1.10",
    "pre-commit>=3.7",
    "pytest>=8",
    "ruff>=0.16",
]

[tool.ruff]
extend = "{{ ruff_base }}"

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]

[tool.mypy]
strict = true
plugins = ["pydantic.mypy"]

[tool.pytest.ini_options]
testpaths = ["tests"]
