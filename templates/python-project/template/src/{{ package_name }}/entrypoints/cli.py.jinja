import logging
import sys

from {{ package_name }}.config import get_settings

logger = logging.getLogger(__name__)


def main() -> int:
    """Read config once, then hand off to app/."""
    config = get_settings()
    logging.basicConfig(level=config.log_level)
    logger.info("started")
    return 0


if __name__ == "__main__":
    sys.exit(main())
