#!/usr/bin/env python3
"""Universal prose and documentation linter runner using Vale.

Runs vale with Google and House technical writing styles against changed
markdown files or explicit target paths.
"""

from __future__ import annotations

import argparse
import re
import shutil
import subprocess
import sys
from pathlib import Path

# Directories and files skipped by default (templates, logs, agent prompts, envs).
SKIP_PATTERN = re.compile(
    r"(^|/)(?:"
    r"(?:\.obsidian|_templates|\.local|\.claude|\.worktrees|worktrees|\.venv|venv|node_modules|raw|archive|\.github)/"
    r"|(?:INDEX|log|CHANGELOG|CLAUDE(?:\.[A-Za-z0-9_-]+)?|AGENTS|SKILL)\.md$"
    r")"
)
WORKTREE_ROOT_PATTERN = re.compile(r"^.*?/(?:\.claude/)?\.?worktrees/[^/]+/")
DEFAULT_CONFIG = Path.home() / "dev/agent-dev-harness/prose-styleguide/.vale.ini"


def _is_skipped_path(path_str: str) -> bool:
    """Check whether a file path should be skipped after stripping any worktree root."""
    normalized = WORKTREE_ROOT_PATTERN.sub("/", path_str)
    return bool(SKIP_PATTERN.search(normalized))


def _find_git_root(cwd: Path) -> Path | None:
    """Find top-level git directory if current path is in a repository."""
    git_bin = shutil.which("git")
    if not git_bin:
        return None
    try:
        proc = subprocess.run(  # noqa: S603  # trusted system git binary
            [git_bin, "rev-parse", "--show-toplevel"],
            cwd=cwd,
            capture_output=True,
            text=True,
            check=True,
        )
        return Path(proc.stdout.strip())
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None


def _find_merge_base(git_bin: str, git_root: Path) -> str:
    """Find the best merge base ref against default branch."""
    for candidate in ("origin/trunk", "origin/main", "trunk", "main"):
        try:
            proc = subprocess.run(  # noqa: S603  # trusted system git binary
                [git_bin, "merge-base", "HEAD", candidate],
                cwd=git_root,
                capture_output=True,
                text=True,
                check=True,
            )
            return proc.stdout.strip()
        except subprocess.CalledProcessError:
            continue
    return "HEAD"


def _get_changed_md_files(git_root: Path) -> list[str]:
    """Collect modified, staged, and untracked markdown files."""
    git_bin = shutil.which("git")
    if not git_bin:
        return []
    base_ref = _find_merge_base(git_bin, git_root)
    git_cmds = [
        [
            git_bin,
            "diff",
            "--name-only",
            "--diff-filter=ACM",
            f"{base_ref}...HEAD",
            "--",
            "*.md",
            "*.mdx",
        ],
        [git_bin, "diff", "--name-only", "--diff-filter=ACM", "--", "*.md", "*.mdx"],
        [
            git_bin,
            "diff",
            "--cached",
            "--name-only",
            "--diff-filter=ACM",
            "--",
            "*.md",
            "*.mdx",
        ],
        [git_bin, "ls-files", "--others", "--exclude-standard", "--", "*.md", "*.mdx"],
    ]

    files: set[str] = set()
    for cmd in git_cmds:
        try:
            res = subprocess.run(  # noqa: S603  # trusted system git binary
                cmd,
                cwd=git_root,
                capture_output=True,
                text=True,
                check=True,
            )
            for raw_line in res.stdout.splitlines():
                entry = raw_line.strip()
                if not entry or SKIP_PATTERN.search(entry):
                    continue
                file_path = git_root / entry
                if file_path.is_file() and entry.endswith((".md", ".mdx")):
                    files.add(str(file_path))
        except subprocess.CalledProcessError:
            continue
    return sorted(files)


def _collect_targets(paths: list[str], cwd: Path) -> list[str]:
    """Resolve target markdown files from arguments or git changed files."""
    if paths:
        targets: list[str] = []
        for p in paths:
            path_obj = Path(p).resolve()
            if path_obj.is_file():
                if not _is_skipped_path(str(path_obj)) and str(path_obj).endswith(
                    (".md", ".mdx")
                ):
                    targets.append(str(path_obj))
            elif path_obj.is_dir():
                for ext in ("*.md", "*.mdx"):
                    for match in path_obj.rglob(ext):
                        rel = str(match.relative_to(path_obj))
                        if not SKIP_PATTERN.search(rel) and not _is_skipped_path(
                            str(match)
                        ):
                            targets.append(str(match.resolve()))
        return targets

    git_root = _find_git_root(cwd)
    if git_root:
        return _get_changed_md_files(git_root)
    return []


def _has_parent_vale_config(target: Path) -> bool:
    """Check if any parent directory of target contains a vale config."""
    for parent in (target, *target.parents):
        if (parent / ".vale.ini").is_file() or (parent / "_vale.ini").is_file():
            return True
    return False


def _run_vale(
    vale_bin: str,
    targets: list[str],
    *,
    min_alert_level: str | None = None,
    output_format: str = "line",
    stdin_text: str | None = None,
) -> tuple[int, str]:
    """Execute vale with specified alert level and output format."""
    cmd = [vale_bin, f"--output={output_format}"]
    if min_alert_level:
        cmd.append(f"--minAlertLevel={min_alert_level}")

    # Fall back to the repo config when neither a local nor a ~/.vale.ini exists.
    user_ini = Path.home() / ".vale.ini"
    needs_fallback = not user_ini.is_file()
    if needs_fallback and DEFAULT_CONFIG.is_file():
        anchor = Path(targets[0]) if targets else Path.cwd()
        if not _has_parent_vale_config(anchor):
            cmd.append(f"--config={DEFAULT_CONFIG}")

    if stdin_text is not None:
        cmd.append("--ext=.md")
    else:
        cmd.extend(targets)

    proc = subprocess.run(  # noqa: S603  # trusted system vale binary
        cmd,
        input=stdin_text,
        capture_output=True,
        text=True,
        check=False,
    )
    combined = (proc.stdout + "\n" + proc.stderr).strip()
    return proc.returncode, combined


def main() -> int:
    """Parse cli options and run vale against targets."""
    parser = argparse.ArgumentParser(
        description="Run prose style checks against Markdown documents using Vale."
    )
    parser.add_argument(
        "paths",
        nargs="*",
        help="Markdown files or directories to lint.",
    )
    parser.add_argument(
        "--stdin",
        action="store_true",
        help="Read Markdown prose from standard input instead of files.",
    )
    parser.add_argument(
        "--min-alert-level",
        choices=["suggestion", "warning", "error"],
        default=None,
        help="Minimum alert level to display (default: from .vale.ini).",
    )
    parser.add_argument(
        "--output",
        choices=["line", "JSON"],
        default="line",
        help="Vale output style (default: line).",
    )
    parser.add_argument(
        "--errors-only",
        action="store_true",
        help="Exit non-zero only on errors, ignoring warnings.",
    )
    args = parser.parse_args()

    vale_bin = shutil.which("vale")
    if not vale_bin:
        sys.stderr.write(
            "error: vale not found on PATH. See https://vale.sh/docs/install\n"
        )
        return 1

    if args.stdin:
        stdin_text = sys.stdin.read()
        if not stdin_text.strip():
            return 0
        returncode, output = _run_vale(
            vale_bin,
            [],
            min_alert_level=args.min_alert_level,
            output_format=args.output,
            stdin_text=stdin_text,
        )
    else:
        target_files = _collect_targets(args.paths, Path.cwd())
        if not target_files:
            print("No Markdown files to check.")
            return 0
        returncode, output = _run_vale(
            vale_bin,
            target_files,
            min_alert_level=args.min_alert_level,
            output_format=args.output,
        )

    if output:
        print(output)

    if args.errors_only:
        return 1 if returncode != 0 else 0

    if returncode != 0 or output:
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
